flowchart TB
  subgraph W["One worker: pool clients share one data path, staging buffer and NIXL agent"]
    direction TB
    subgraph PY["Python loader: active transfers only"]
      direction LR
      Q["Query status"] --> N["NativeNixlAgent<br/>Public C++ status API<br/>Also progresses UCX"]
      N -->|"DONE"| D["Transfer complete"]
      N -->|"In progress"| S["Pause 200 µs"]
      S --> Q
    end
    subgraph CPP["Worker progress ON: independent NIXL C++ thread"]
      direction LR
      P["Progress UCX"] --> A{"arm"}
      A -->|"Work pending"| P
      A -->|"Wait ready"| E["UCX event FD / poll<br/>1 ms timeout setting<br/>NIC event wakes early"]
      E -->|"Event or timeout"| P
    end
    PY ~~~ CPP
  end
  M["Memory agent: background progress OFF<br/>Bounded ConnectProgress during connection"]
  W ~~~ M
